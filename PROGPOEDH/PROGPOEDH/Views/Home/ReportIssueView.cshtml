@model PROGPOEDH.Models.FormModel

<div class="glass glass-sm mt-3">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h4 class="mb-1">Create report</h4>
            <p class="small mb-0" style="color: rgba(255,255,255,0.78);">
                Submit a new report with location, category, description and optional media. Attachments
                (image/document) will be uploaded to the server — keep file sizes reasonable.
            </p>
        </div>
  
    </div>

    <form asp-action="SubmitReport" asp-controller="Form" method="post" enctype="multipart/form-data" class="mt-3">

        <div class="form-group mb-2">
            <label asp-for="Location" class="form-label fw-bold"></label>
            <input asp-for="Location" class="form-control shadow-sm" placeholder="e.g. Park Avenue, Block A" required />
        </div>

        <div class="form-group mb-2">
            <label asp-for="Category" class="form-label fw-bold"></label>
            <select asp-for="Category" class="form-select shadow-sm" required>
                <option value="">-- Select category --</option>
                <option>Road / Pothole</option>
                <option>Stormwater / Flooding</option>
                <option>Sewer / Sanitation</option>
                <option>Water Supply / Pressure</option>
                <option>Garbage / Waste Collection</option>
                <option>Street Lighting</option>
                <option>Electricity / Power</option>
                <option>Traffic Signals / Road Signs</option>
                <option>Public Transport</option>
                <option>Vandalism / Graffiti</option>
                <option>Noise Complaint</option>
                <option>Green Spaces / Trees</option>
                <option>Pest / Rodent Control</option>
                <option>Illegal Land Use / Informal Settlement</option>
                <option>Other</option>
            </select>
        </div>

        <div class="form-group mb-2">
            <label asp-for="Description" class="form-label fw-bold"></label>
            <input asp-for="Description" class="form-control shadow-sm" placeholder="Provide more details about the issue" required />
        </div>
        <div class="form-group mb-2">
            <label asp-for="PictureFile" class="form-label fw-bold"></label>
            <input asp-for="PictureFile" type="file" class="form-control shadow-sm" required/>
        </div>

        <div class="form-group mb-3">
            <label asp-for="DocumentFile" class="form-label fw-bold"></label>
            <input asp-for="DocumentFile" type="file" class="form-control shadow-sm" required/>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2 shadow-sm" aria-label="Submit report">
            Submit
        </button>

        @* show TempData message if your controller sets it *@
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success mt-3 shadow-sm" role="alert">@TempData["Message"]</div>
        }
    </form>
</div>
