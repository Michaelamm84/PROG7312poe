@model IEnumerable<PROGPOEDH.Models.FormModel>

<h2 class="mb-4">All Reports</h2>

<div class="row">
    @foreach (var report in Model)
    {
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body">
                    <h5 class="card-title text-primary">@report.Category</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@report.Location</h6>
                    <p class="card-text">@report.Description</p>

                    <div class="d-flex gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(report.viewPicture) && report.viewPicture.StartsWith("data:image"))
                        {
                            <img src="@report.viewPicture" alt="Report Image" class="img-fluid rounded border" style="max-width:200px; max-height:200px;" />
                        }
                        else
                        {
                            <span class="text-muted">No image uploaded</span>
                        }

                        @if (!string.IsNullOrEmpty(report.viewDocument) && report.viewDocument.StartsWith("data:application/pdf"))
                        {
                            <embed src="@report.viewDocument" type="application/pdf" width="200" height="200" class="border rounded" />
                        }
                        else
                        {
                            <span class="text-muted">No PDF uploaded</span>
                        }
                    </div>

                  @*   @if (!string.IsNullOrEmpty(report.viewDocument))
                    {
                        <a href="@Url.Action("DownloadPdf", "Form", new { id = report.Id })" class="btn btn-sm btn-outline-primary">
                            Download PDF
                        </a>
                    } *@
                </div>
            </div>
        </div>
    }
</div>
