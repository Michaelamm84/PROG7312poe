@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<style>
    /* Full-page background — replace the URL or use a gradient */
    .page-bg {
        min-height: 100vh;
        background-image: url('/images/cape-town.jpg'); /* <- replace with your image path */
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
    }

    /* Glass / blurred rounded box */
    .glass {
        width: 100%;
        max-width: 1000px;
        background: rgba(255,255,255,0.08); /* light tint */
        border-radius: 1rem;
        padding: 2.2rem;
        box-shadow: 0 8px 30px rgba(0,0,0,0.35);
        border: 1px solid rgba(255,255,255,0.12);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        color: #ffffff;
    }

    /* Slightly stronger inner panel for text readability on small screens */
    .glass .lead {
        color: rgba(255,255,255,0.9);
    }

    /* Make disabled buttons visually subdued but still clickable for tooltip */
    .btn-not-implemented {
        pointer-events: none; /* prevents click */
        opacity: 0.55;
        filter: grayscale(0.1);
    }

    /* Layout helpers */
    .glass .actions {
        margin-top: 1.25rem;
    }

   
</style>

<div class="page-bg">
    <div class="glass">
        <!-- Header -->
        <div class="text-center mb-3">
            <h1 class="fw-bold mb-1">@ViewData["Title"]</h1>
            <p class="mb-0 small text-uppercase" style="letter-spacing:.12em; color: rgba(255,255,255,0.7);">Album example</p>
        </div>

        <!-- Short description about the application -->
        <div class="px-1">
            <p class="lead">
                This application is a lightweight album/collection manager that demonstrates item listing,
                basic item actions, and a simple issue-reporting flow. The panel you see here explains the app's
                purpose and status.
            </p>

            <ul>
                <li>Manage items (view, edit) — UI shown but not implemented in this prototype.</li>
                <li>Report issues — <strong>active</strong> (use this to send feedback or file bugs).</li>
                <li>Additional features listed in the UI are placeholders and will be implemented later.</li>
            </ul> </div>
        <div class="glass glass-sm mt-3">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h4 class="mb-1">Populate app</h4>
                    <p class="small mb-0" style="color: rgba(255,255,255,0.78);">
                        Seed demo/sample data into the application. The server-side `Populate` action will handle the insertion.
                    </p>
                </div>
                <div class="text-end">
                    <small class="text-muted">Writes to DB</small>
                </div>
            </div>

            <form asp-controller="Home" asp-action="Populate" method="post" class="mt-3 m-0 p-0">
               
                <button type="submit" class="btn btn-success" id="populateBtn" aria-label="Populate application with demo data">
                    <!-- optional icon if you include Bootstrap Icons -->
                    <span class="me-1" aria-hidden="true">⬇️</span>
                    Populate app
                </button>
            </form>

            <small class="text-muted d-block mt-2">Tip: this calls `ItemsController.Populate` (POST).</small>
        </div>

            <p class="small mb-0" style="color: rgba(255,255,255,0.75);">
                Note: Only the <em>Report issue</em> action is wired to the backend at the moment. Other actions are visible
