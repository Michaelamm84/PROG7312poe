@model PROGPOEDH.Models.LocalEvent

@{
    ViewData["Title"] = "Add New Event";
}

<!-- 🌈 Modern Layout -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #dbeafe, #e0f2fe);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI', sans-serif;
    }

    .form-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
        padding: 2.5rem;
        width: 90%;
        max-width: 600px;
    }

    h2 {
        text-align: center;
        margin-bottom: 1.5rem;
        font-weight: 600;
    }

    .btn-submit {
        width: 100%;
        border-radius: 0.5rem;
        padding: 0.75rem;
        font-size: 1.1rem;
    }

    label {
        font-weight: 500;
    }
</style>

<div class="form-card">
    <h2>➕ Add New Event</h2>

    <form asp-action="SubmitEvent" asp-controller="Events" method="post">
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Event Title</label>
            <input asp-for="Title" class="form-control" placeholder="Enter event title" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label">Category</label>
            <input asp-for="Category" class="form-control" placeholder="e.g., Sports, Community, Education" required />
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Date" class="form-label">Event Date</label>
            <input asp-for="Date" type="date" class="form-control" required />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter a short description..." required></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Priority" class="form-label">Priority (1 = Highest)</label>
            <input asp-for="Priority" type="number" min="1" max="10" class="form-control" required />
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-submit">
            💾 Add Event
        </button>

        <a asp-action="Index" asp-controller="Events" class="btn btn-outline-secondary mt-3 w-100">
            ⬅ Back to Events Menu
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
