@model List<PROGPOEDH.Models.LocalEvent>
@{
    var selected = ViewBag.SelectedCategory as string;
}

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background-color: #101010;
        color: #f0f0f0;
        padding: 30px;
    }

    h2 {
        color: #4caf50;
    }

    h3 {
        margin-top: 20px;
        color: #03a9f4;
    }

    select, button {
        padding: 10px;
        border: none;
        border-radius: 6px;
        margin: 6px 0;
    }

    select {
        width: 270px;
        background-color: #1e1e1e;
        color: #fff;
    }

    button {
        background-color: #4caf50;
        color: white;
        cursor: pointer;
        transition: 0.3s;
    }

        button:hover {
            background-color: #388e3c;
        }

    li {
        list-style: none;
        background-color: #1c1c1c;
        margin: 8px 0;
        padding: 8px;
        border-radius: 5px;
    }
</style>

<h2>🔍 Search Events by Category</h2>

<form asp-controller="Events" asp-action="SearchCategory" method="get">
    <select name="category" required>
        <option value="">-- Choose --</option>
        @foreach (var c in (IEnumerable<string>)ViewBag.AllCategories)
        {
            if (c == selected)
            {
                <option value="@c" selected>@c</option>
            }
            else
            {
                <option value="@c">@c</option>
            }
        }
    </select>
    <button type="submit">Search</button>
</form>

@if (!string.IsNullOrEmpty(selected))
{
    <h3>Results for "@selected"</h3>

    @if (Model != null && Model.Count > 0)
    {
        <ul>
            @foreach (var e in Model)
            {
                <li><b>@e.Title</b> — @e.Category — @e.Date.ToShortDateString()</li>
            }
        </ul>
    }
    else
    {
        <p>@ViewBag.Message ?? "No events found."</p>
    }
}
