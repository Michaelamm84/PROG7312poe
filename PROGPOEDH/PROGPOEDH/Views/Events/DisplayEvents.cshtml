@model IEnumerable<PROGPOEDH.Models.LocalEvent>

@{
    ViewData["Title"] = "Events";
}

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #181818;
        color: #f5f5f5;
        padding: 20px;
    }

    h2 {
        color: #ffb74d;
    }

    li {
        margin: 8px 0;
        padding: 10px;
        border-radius: 5px;
        background: #252525;
        color: #fff;
    }

        li:hover {
            background-color: #333;
        }
</style>

<h2>🎉 Events</h2>
<ul>
    @foreach (var e in Model ?? Enumerable.Empty<PROGPOEDH.Models.LocalEvent>())
    {
        <li><b>@e.Title</b> — @e.Category — @e.Date.ToShortDateString()</li>
    }
</ul>
<div class="actions">
    <form asp-controller="Home" asp-action="EventIndex" method="get">
        <button type="submit">⬅ Back to Main</button>
    </form>
</div>
