@model Dictionary<string, List<PROGPOEDH.Models.LocalEvent>>

@{
    ViewData["Title"] = "Events grouped by category";
}

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #121212;
        color: #f1f1f1;
        padding: 20px;
    }

    h2, h3 {
        color: #00bcd4;
    }

    ul {
        list-style-type: none;
        padding-left: 20px;
    }

    li {
        margin: 6px 0;
        padding: 8px;
        background-color: #1e1e1e;
        border-radius: 8px;
        color: #fff;
        transition: background 0.3s;
    }

        li:hover {
            background-color: #333;
        }
</style>

<h2>📚 Events grouped by category</h2>

@foreach (var kv in Model)
{
    <h3>@kv.Key (@kv.Value.Count)</h3>
    <ul>
        @foreach (var e in kv.Value)
        {
            <li><b>@e.Title</b> — @e.Date.ToShortDateString()</li>
        }
    </ul>
}
