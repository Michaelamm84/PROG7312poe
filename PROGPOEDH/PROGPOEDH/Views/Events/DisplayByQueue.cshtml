@model IEnumerable<PROGPOEDH.Models.LocalEvent>

@{
    ViewData["Title"] = "Events";
    Layout = "_Layout";
}

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    .page-bg {
        min-height: 100vh;
        background: url('/images/cape-town.jpg') center/cover fixed;
        display: block;
        padding: 3rem 1rem;
    }

    .glass {
        position: fixed !important;
        top: 2rem !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
        z-index: 9999;
        max-width: 900px !important;
        width: calc(100% - 2rem) !important;
        background: rgba(255,255,255,0.15) !important;
        color: #111 !important;
        border-radius: 1rem !important;
        padding: 1.5rem !important;
        backdrop-filter: blur(12px) !important;
        box-shadow: 0 8px 30px rgba(0,0,0,0.35) !important;
        max-height: calc(100vh - 4rem) !important;
        overflow-y: auto !important;
    }

    h2 {
        color: #222;
        text-shadow: 1px 1px 2px rgba(255,255,255,0.4);
        margin: 0 0 12px 0;
    }

    .queue-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 15px;
        align-content: start;
        align-items: start;
        width: 100%;
    }

    .event-card {
        background: rgba(255,255,255,0.25);
        padding: 14px;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        transition: transform 0.2s, background 0.3s;
        color: #222;
    }

        .event-card:hover {
            transform: translateY(-4px);
            background: rgba(255,255,255,0.4);
        }

    .event-title {
        font-weight: 600;
        font-size: 1.1em;
        margin-bottom: 6px;
    }

    .event-category {
        font-size: 0.9em;
        color: #333;
    }

    .event-date {
        font-size: 0.9em;
        color: #1565c0;
        margin-top: 6px;
    }

    .actions {
        margin-top: 16px;
        display: flex;
        gap: 10px;
        justify-content: flex-start;
    }

    button {
        background: rgba(255,255,255,0.6);
        border: none;
        border-radius: 8px;
        padding: 8px 14px;
        cursor: pointer;
        font-weight: 600;
        transition: 0.3s;
        color: #111;
    }

        button:hover {
            background: rgba(255,255,255,0.85);
        }
</style>

<div class="page-bg">
    <div class="glass">
        <h2>⏳ Events (Queue - Oldest First)</h2>

        @if (Model != null && Model.Any())
        {
            <div class="queue-container">
                @foreach (var e in Model)
                {
                    <div class="event-card">
                        <div class="event-title">@e.Title</div>
                        <div class="event-category">@e.Category</div>
                        <div class="event-date">@e.Date.ToShortDateString()</div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No events in the queue.</p>
        }

        <div class="actions">
            <form asp-controller="Events" asp-action="EventIndex" method="get">
                <button type="submit">⬅ Back to Main</button>
            </form>
        </div>
    </div>
</div>
