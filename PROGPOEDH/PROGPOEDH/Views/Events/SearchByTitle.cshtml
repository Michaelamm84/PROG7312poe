@model List<PROGPOEDH.Models.LocalEvent>
@{
    var query = ViewBag.Query as string;
    Layout = "_Layout";
}

<style>
    .page-bg {
        min-height: 100vh;
        background: url('/images/cape-town.jpg') center/cover fixed;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 3rem 1rem;
    }

    .glass {
        max-width: 900px;
        width: 100%;
        background: rgba(255,255,255,0.15);
        color: #111;
        border-radius: 1rem;
        padding: 2rem;
        backdrop-filter: blur(12px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.35);
    }

    h2 {
        color: #222;
        text-shadow: 1px 1px 2px rgba(255,255,255,0.4);
    }

    h3 {
        color: #1b5e20;
        margin-top: 20px;
    }

    input[type="text"], button {
        padding: 10px;
        border: none;
        border-radius: 6px;
        margin: 6px 0;
        background: rgba(255,255,255,0.7);
        color: #111;
        font-weight: 500;
    }

    button {
        background: rgba(255,255,255,0.6);
        transition: 0.3s;
        cursor: pointer;
    }

        button:hover {
            background: rgba(255,255,255,0.85);
        }

    .calendar-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 15px;
        margin-top: 20px;
    }

    .event-card {
        background: rgba(255,255,255,0.25);
        padding: 14px;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        color: #222;
        transition: 0.3s;
    }

        .event-card:hover {
            background: rgba(255,255,255,0.4);
            transform: translateY(-4px);
        }

    .event-title {
        font-weight: 600;
        font-size: 1.1em;
        margin-bottom: 4px;
    }

    .event-category {
        font-size: 0.9em;
        color: #333;
    }

    .event-date {
        font-size: 0.9em;
        color: #2e7d32;
        margin-top: 6px;
    }

    .no-results {
        color: #c62828;
        font-weight: 500;
        margin-top: 10px;
    }
</style>

<div class="page-bg">
    <div class="glass">
        <h2>🔍 Search Events by Title</h2>

        <form asp-controller="Events" asp-action="SearchTitle" method="get">
            <input type="text" name="q" placeholder="Enter title..." required />
            <button type="submit">Search</button>
        </form>

        @if (!string.IsNullOrEmpty(query))
        {
            <h3>Results for: "@query"</h3>

            @if (Model != null && Model.Count > 0)
            {
                <div class="calendar-container">
                    @foreach (var e in Model)
                    {
                        <div class="event-card">
                            <div class="event-title">@e.Title</div>
                            <div class="event-category">@e.Category</div>
                            <div class="event-date">@e.Date.ToShortDateString()</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="no-results">No events found.</p>
            }
        }

        @if (ViewBag.Suggestions != null)
        {
            <h3>✨ Suggested Events</h3>
            <div class="calendar-container">
                @foreach (var s in ViewBag.Suggestions as List<PROGPOEDH.Models.LocalEvent>)
                {
                    <div class="event-card">
                        <div class="event-title">@s.Title</div>
                        <div class="event-category">@s.Category</div>
                        <div class="event-date">@s.Date.ToShortDateString()</div>
                    </div>
                }
            </div>
        }

        <div class="actions">
            <form asp-controller="Home" asp-action="EventIndex" method="get">
                <button type="submit">⬅ Back to Main</button>
            </form>
        </div>
    </div>
</div>