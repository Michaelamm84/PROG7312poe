@{
    ViewData["Title"] = "Events - Main";
}

<h2>Events - Choose a View</h2>

<div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:20px;">
    <!-- ✅ Button to populate events -->
    <form asp-controller="Events" asp-action="PopulateEvents" method="post">
        <button type="submit" style="background-color:#28a745; color:white; padding:8px 15px; border:none; border-radius:5px;">
            Populate Events
        </button>
    </form>

    <form asp-controller="Events" asp-action="DisplayAllByCategory" method="get">
        <button type="submit">View All (by Category)</button>
    </form>

    <form asp-controller="Events" asp-action="DisplayByStack" method="get">
        <button type="submit">View (Stack) — newest first</button>
    </form>

    <form asp-controller="Events" asp-action="DisplayByQueue" method="get">
        <button type="submit">View (Queue) — newest first (queue option)</button>
    </form>

    <form asp-controller="Events" asp-action="SearchCatagory" method="get">
        <button type="submit">Search by Category</button>
    </form>

    <form asp-controller="Events" asp-action="SearchDate" method="get">
        <button type="submit">Search by Date</button>
    </form>

    <form asp-controller="Events" asp-action="SearchByTitle" method="get">
        <button type="submit">Search by Title</button>
    </form>

</div>
