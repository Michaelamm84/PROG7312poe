@{
    ViewData["Title"] = "Local Events & Announcements";
}

<!-- 🌈 Modern Menu Layout -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #f3f4f6, #dbeafe);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI', sans-serif;
    }

    .menu-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
        padding: 3rem 2rem;
        width: 90%;
        max-width: 600px;
        text-align: center;
    }

    .menu-title {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .menu-subtitle {
        color: #6b7280;
        margin-bottom: 2.5rem;
    }

    .btn-option {
        border-radius: 0.75rem;
        padding: 1rem 2rem;
        width: 100%;
        font-size: 1.2rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

        .btn-option:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }
</style>

<div class="menu-card">
    <h2 class="menu-title">📢 Local Events & Announcements</h2>
    <p class="menu-subtitle">Choose what you’d like to do:</p>

    <div class="d-grid gap-3">
        <!-- 🗓 View All Events -->
        <a asp-controller="Events" asp-action="ViewAll" class="btn btn-primary btn-option">
            🗓 View All Events
        </a>

        <!-- 🔍 Search Events -->
        <a asp-controller="Events" asp-action="Search" class="btn btn-success btn-option">
            🔍 Search Events
        </a>

        <!-- 🏠 Back to Main Menu -->
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-option">
            ⬅ Back to Main Menu
        </a>
    </div>
</div>
