@model List<LocalEvent>
@{
    var selected = ViewBag.SelectedCategory as string;
}

<h2>Search by Category</h2>

<form asp-controller="Events" asp-action="SearchCatagory" method="get">
    <select name="category" required>
        <option value="">-- Choose --</option>

        @foreach (var c in (IEnumerable<string>)ViewBag.AllCategories)
        {
            if (c == selected)
            {
                <option value="@c" selected>@c</option>
            }
            else
            {
                <option value="@c">@c</option>
            }
        }
    </select>

    <button type="submit">Search</button>
</form>

@if (selected != null)
{
    <h3>Results for @selected</h3>

    @if (Model != null && Model.Count > 0)
    {
        <ul>
            @foreach (var e in Model)
            {
                <li>@e.Title — @e.Date.ToShortDateString()</li>
            }
        </ul>
    }
    else
    {
        <p>@ViewBag.Message</p>
    }
}
