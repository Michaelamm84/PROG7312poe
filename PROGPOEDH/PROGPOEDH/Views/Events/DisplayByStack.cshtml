@model IEnumerable<PROGPOEDH.Models.LocalEvent>

@{
    ViewData["Title"] = "Events (Stack - Furthest away First)";
    Layout = "_Layout";
}

<style>
    .page-bg {
        min-height: 100vh;
        background: url('/images/cape-town.jpg') center/cover fixed;
        display: flex;
        justify-content: center; /* horizontal center */
        align-items: flex-start; /* align glass at top of viewport */
        padding: 3rem 1rem;
    }

    .glass {
        max-width: 900px;
        width: 100%;
        background: rgba(255,255,255,0.15);
        color: #111;
        border-radius: 1rem;
        padding: 2rem;
        backdrop-filter: blur(12px);
        box-shadow: 0 8px 30px rgba(0,0,0,0.35);
        /* keep the panel bounded and allow scrolling for long lists */
        max-height: calc(100vh - 4rem);
        overflow-y: auto;
    }

    h2 {
        color: #222;
        text-shadow: 1px 1px 2px rgba(255,255,255,0.4);
        margin-top: 0;
    }

    .stack-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 15px;
        margin-top: 20px;
        align-content: start; /* pack grid items from the top */
    }

    .event-card {
        background: rgba(255,255,255,0.25);
        padding: 14px;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        transition: transform 0.2s, background 0.3s;
        color: #222;
    }

        .event-card:hover {
            transform: translateY(-4px);
            background: rgba(255,255,255,0.4);
        }

    .event-title {
        font-weight: 600;
        font-size: 1.1em;
        margin-bottom: 6px;
    }

    .event-category {
        font-size: 0.9em;
        color: #333;
    }

    .event-date {
        font-size: 0.9em;
        color: #2e7d32;
        margin-top: 6px;
    }

    button {
        background: rgba(255,255,255,0.6);
        border: none;
        border-radius: 8px;
        padding: 8px 14px;
        margin-top: 20px;
        cursor: pointer;
        font-weight: 600;
        transition: 0.3s;
        color: #111;
    }

        button:hover {
            background: rgba(255,255,255,0.85);
        }
</style>

<div class="page-bg">
    <div class="glass">
        <h2>🧱 Events (Stack - Newest First)</h2>

        @if (Model != null && Model.Any())
        {
            <div class="stack-container">
                @foreach (var e in Model)
                {
                    <div class="event-card">
                        <div class="event-title">@e.Title</div>
                        <div class="event-category">@e.Category</div>
                        <div class="event-date">@e.Date.ToShortDateString()</div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No events in the stack.</p>
        }

        <form asp-controller="Events" asp-action="EventIndex" method="get">
            <button>⬅ Back to Main</button>
        </form>
    </div>
</div>
