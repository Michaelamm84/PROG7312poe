<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MyApp</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid">
        <div class="row flex-nowrap">
            <!-- Sidebar -->
            <nav class="col-auto col-md-3 col-xl-2 bg-dark px-0">
                <div class="d-flex flex-column align-items-start min-vh-100 p-3 text-white">
                    <a asp-controller="Home" asp-action="Index" class="navbar-brand text-white mb-4">Menu</a>
                    <ul class="nav nav-pills flex-column mb-auto">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link text-white">Home</a>
                        </li>
                      
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="reportIssue" class="nav-link text-white">Report Issues</a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="ShowReports" class="nav-link text-white">Show Reports</a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="deleteView" class="nav-link text-white">delete Reports</a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="del" class="nav-link text-white">Local Events and Announcements (coming soon)</a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="del" class="nav-link text-white">Service request Status (coming soon)</a>
                        </li>
                    </ul>
                </div>
            </nav>
            <!-- Main content -->
            <div class="col py-3">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS (optional) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
