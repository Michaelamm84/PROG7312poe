@model IEnumerable<PROGPOEDH.Models.FormModel>

<h2>All Reports</h2>

<table class="table">
    <thead>
        <tr>
            <th>Location</th>
            <th>Name</th>
            <th>Description</th>
            <th>Picture</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var report in Model)
        {
            <tr>
                <td>@report.Location</td>
                <td>@report.Category</td>
                <td>@report.Description</td>
                <td>
                    @if (!string.IsNullOrEmpty(report.viewPicture))
                    {
                        if (report.viewPicture.StartsWith("data:image"))
                        {
                            <img src="@report.viewPicture" alt="Report Image" width="200" />
                        }
                        else if (report.viewPicture.StartsWith("data:application/pdf"))
                        {
                            <embed src="@report.viewPicture" type="application/pdf" width="200" height="200" />
                        }
                    }
                    else
                    {
                        <span>No file uploaded</span>
                    }
                </td>
                @if (!string.IsNullOrEmpty(report.viewDocument))
                {
                     if (report.viewDocument.StartsWith("data:application/pdf"))
                    {
                        <embed src="@report.viewDocument" type="application/pdf" width="200" height="200" />
                    }
                }
                else
                {
                    <span>No file uploaded</span>
                }

                <td>
                <td>
                    <a href="@Url.Action("DownloadPdf", "Form" , report.DocumentFile)" class="btn btn-primary">Download PDF</a>
                </td>


                </td>
            </tr>
        }
    </tbody>
</table>
